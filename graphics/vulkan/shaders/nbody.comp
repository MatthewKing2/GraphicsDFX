#version 450

// One invocation owns one particle. Dispatch enough groups to cover NUM_STARS.
layout(local_size_x = 128) in;

layout(push_constant) uniform GravConstants {
    float STEP_SIZE;
    float GRAV_SOFT;
    float GRAV_CONS;
    uint NUM_STARS;
} matthew_grav;
struct gpu_particle {
    vec4 positionMass; // x, y, z, mass
    vec4 velocity;     // x, y, z, unused
};

// Every invocation reads the same frozen snapshot and writes only output[i].
layout(set = 0, binding = 0, std430) readonly buffer InputParticles {
    gpu_particle particles[];
} input_state;

layout(set = 0, binding = 1, std430) writeonly buffer OutputParticles {
    gpu_particle particles[];
} output_state;

// The existing vertex shader reads this same buffer at graphics binding 2.
layout(set = 0, binding = 2, std430) writeonly buffer ModelMatrices {
    mat4 models[];
} instances;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= matthew_grav.NUM_STARS) return;

    gpu_particle particle = input_state.particles[i];
    vec3 my_position = particle.positionMass.xyz;
    vec3 my_acceleration = vec3(0.0);

    // Same all-pairs gravity as the CPU implementation, in three dimensions.
    for (uint j = 0; j < matthew_grav.NUM_STARS; ++j) {
        if (j == i) continue;

        vec4 other = input_state.particles[j].positionMass;
        vec3 dist = other.xyz - my_position;
        float distance_squared = dot(dist, dist)
            + matthew_grav.GRAV_SOFT * matthew_grav.GRAV_SOFT;
        float inverse_distance = inversesqrt(distance_squared);
        float inverse_distance_cubed = inverse_distance
            * inverse_distance * inverse_distance;
        my_acceleration += matthew_grav.GRAV_CONS * other.w
            * inverse_distance_cubed * dist;
    }

    // Semi-implicit Euler: update velocity first, then position with NEW velocity.
    vec3 new_velocity = particle.velocity.xyz
        + matthew_grav.STEP_SIZE * my_acceleration;
    vec3 new_position = my_position + matthew_grav.STEP_SIZE * new_velocity;
    particle.positionMass = vec4(new_position, particle.positionMass.w);
    particle.velocity = vec4(new_velocity, 0.0);
    output_state.particles[i] = particle;

    // GLSL matrices are column-major; column 3 holds the translation.
    mat4 model_matrix = mat4(1.0);
    model_matrix[3] = vec4(new_position, 1.0);
    instances.models[i] = model_matrix;
}
